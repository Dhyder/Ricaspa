{
  "routes": [
    {
      "routePath": "/api/create-voucher",
      "mountPath": "/api",
      "method": "POST",
      "module": [
        "api/create-voucher.js:onRequestPost"
      ]
    },
    {
      "routePath": "/api/initiate-payment",
      "mountPath": "/api",
      "method": "POST",
      "module": [
        "api/initiate-payment.js:onRequestPost"
      ]
    },
    {
      "routePath": "/api/order-status",
      "mountPath": "/api",
      "method": "GET",
      "module": [
        "api/order-status.js:onRequestGet"
      ]
    },
    {
      "routePath": "/api/payment-webhook",
      "mountPath": "/api",
      "method": "POST",
      "module": [
        "api/payment-webhook.js:onRequestPost"
      ]
    }
  ],
  "baseURL": "/"
}